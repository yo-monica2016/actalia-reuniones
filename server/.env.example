DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=actalia_reuniones
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Transcripción y resumen: solo OpenAI (no hace falta Python ni Whisper en el PC)
TRANSCRIPTION_PROVIDER=openai
SUMMARY_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize
# Diarización por trozo: si un fragmento supera este MB, usa whisper-1 en ese trozo
OPENAI_DIARIZE_MAX_MB=24
OPENAI_DIARIZE_MAX_RETRIES=2
OPENAI_DIARIZE_TIMEOUT_MS=300000
OPENAI_DIARIZE_RETRY_DELAY_MS=2000
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_RESUMEN_MAX_TOKENS=4096

# Troceado por silencios (solo en el servidor; el usuario no instala FFmpeg)
AUDIO_CHUNK_MIN_SEC=600
AUDIO_CHUNK_MAX_SEC=900
AUDIO_CHUNK_TARGET_SEC=720
AUDIO_SILENCE_NOISE_DB=-35
AUDIO_SILENCE_MIN_SEC=0.5
AUDIO_COMPRESS_BITRATE=64k
# FFmpeg: por defecto viene con npm install (ffmpeg-static + ffprobe-static).
# Solo si quieres usar otro binario en el servidor:
# FFMPEG_PATH=C:\ruta\a\ffmpeg.exe
# FFPROBE_PATH=C:\ruta\a\ffprobe.exe

# Resumen local (solo si SUMMARY_PROVIDER=local o falla OpenAI)
RESUMEN_MAX_ORACIONES=4
RESUMEN_MAX_CHARS=500

# OCR (imágenes; opcional en el servidor)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=c:\laragon\www\actalia-reuniones\server\tessdata
OCR_LANG=spa

# Interpretación de imágenes con visión (requiere OPENAI_API_KEY)
# IMAGE_VISION_PROVIDER=openai
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_VISION_MAX_PX=1280
# OPENAI_VISION_MAX_TOKENS=120

# Logo en portada del acta PDF (PNG o JPG en server/assets/)
PDF_ACTA_LOGO_PATH=c:\laragon\www\actalia-reuniones\server\assets\logo.png
