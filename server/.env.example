DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=actalia_reuniones
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Python / Whisper (transcripción local)
PYTHON_CMD=py
WHISPER_MODEL=small
WHISPER_LANGUAGE=Spanish
WHISPER_TEMPERATURE=0
# false = menos repeticiones en bucle ("es lo mismo…")
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
# Opcional: contexto para términos del tema (reunión, empresa, etc.)
# WHISPER_INITIAL_PROMPT=Reunión en español. Transcripción literal de lo hablado.
WHISPER_LIMPIAR_REPETICIONES=true
# WHISPER_BEAM_SIZE=5

# OCR (imágenes)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=c:\laragon\www\actalia-reuniones\server\tessdata
OCR_LANG=spa

# Resumen local (fallback si OpenAI falla o SUMMARY_PROVIDER=local)
RESUMEN_MAX_ORACIONES=4
RESUMEN_MAX_CHARS=500

# OpenAI (transcripción y resumen en la nube)
# TRANSCRIPTION_PROVIDER=openai
# SUMMARY_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_RESUMEN_MAX_TOKENS=4096
